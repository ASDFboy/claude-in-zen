{
  "manifest_version": 2,
  "name": "Claude Bridge for Zen",
  "version": "0.1.0",
  "author": "ASDFboy and Claude",
  "homepage_url": "https://github.com/ASDFboy/claude-in-zen",
  "description": "Unofficial. Lets Claude (through a local MCP server) see and control the tabs you share with it in Zen or Firefox.",
  "browser_specific_settings": {
    "gecko": {
      "id": "claude-bridge-for-zen@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "permissions": ["tabs", "<all_urls>", "storage", "webNavigation", "webRequest"],
  "browser_action": {
    "default_title": "Claude Bridge",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  }
}
